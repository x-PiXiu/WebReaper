# WebReaper 配置模板
# 复制为 .env 并填入真实值。.env 文件已被 .gitignore 保护，不会入库。

# 应用配置
SERVER_PORT=8082
APP_ENV=development

# MySQL 配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=agentcore
DB_SSLMODE=disable

# JWT 配置（生产环境 JWT_SECRET 必须 >= 32 字符）
JWT_SECRET=
JWT_EXPIRATION=3600

# LLM 配置（OpenAI 兼容协议，支持 MiniMax/OpenAI/智谱等）
LLM_PROVIDER=minimax
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.5

# 多平台发布 cookie 加密密钥（AES-256-GCM）
# 商户扫码登录后获取的 cookie 用此密钥加密存库；不配置则扫码登录不可用（半自动发布仍可用）
PUBLISH_COOKIE_SECRET=

# 扫码登录浏览器模式：false=headless灰盒（默认），true=显示浏览器窗口（调试用）
QR_LOGIN_HEADED=false

# 爬虫限流配置（可动态调配采集速率，避免压垮目标站）
# 请求间隔（毫秒）：同域名两次请求的最小间隔，默认 1000（1秒）
CRAWLER_REQUEST_INTERVAL_MS=1000
# 单请求超时（毫秒），默认 30000（30秒）
CRAWLER_REQUEST_TIMEOUT_MS=30000
# 自定义 User-Agent
CRAWLER_USER_AGENT=WebReaper/1.0

# 链路追踪配置（OpenTelemetry）
# 是否启用 trace（true/false），开发模式默认开
TELEMETRY_ENABLED=true
# exporter 类型：stdout（控制台，开发）/ otlp（发往 Collector，生产）
TELEMETRY_EXPORTER=stdout
# OTLP/HTTP 端点，仅 TELEMETRY_EXPORTER=otlp 时生效。如 Jaeger/Tempo 的 4318 端口
# 示例：localhost:4318（本地 Collector，自动用 HTTP 明文）
TELEMETRY_OTLP_ENDPOINT=

# 每日自动监测（自动盯盘：趋势图自动生长，无需手动点监测）
# 需要 DB + LLM 已配置；true 启用（每天对全平台品牌执行一次监测）
AUTO_MONITOR_ENABLED=false

# 收录状态验证（IndexNow 提交 ≠ 收录：每日验证已发布内容是否被 Bing 真正收录）
# BING_API_KEY 在 Bing Webmaster Tools 获取（Bing Webmaster API）
# BING_SITE_URL 必须是已在 Bing 验证过的站点（如 https://content.example.com）
BING_API_KEY=
BING_SITE_URL=

# 视频生成工作台（Vidu 开放平台）
# 未配置时视频工作台运行在 mock 模式（模拟生成进度，可完整演示流程不消耗积分）
# VIDU_API_KEY 在 platform.vidu.cn 控制台获取；运行时以管理后台"厂商配置"为准，此处仅作启动兜底
VIDU_API_KEY=

# 高德地图 Web 服务（本地生活 GEO：门店地理编码 + 周边同行 POI 搜索）
# 申请：https://console.amap.com/ 创建"Web 服务"Key（个人开发者日配额约 5000 次）
# 不配置则降级：门店照常创建（标记"待定位"），附近同行页只显示 AI 竞品榜
# 注意：商用场景需核实高德商业授权条款（见 Docs/Plans/01-本地生活GEO改造与优化完善计划.md § 风险）
AMAP_API_KEY=
# 周边搜索接口版本：v5（默认，推荐——show_fields 精确取字段，含评分/人均/商圈/营业时间）
# v3（旧版兼容保留，作降级开关：仅距离+评分，评分在 base 模式可能缺失）
AMAP_API_VERSION=v5

# LLM 参考单价（每百万 tokens 的成本，单位：分）——admin 成本分析报表用
# 例：MiniMax M2.5 约 ¥1/百万 tokens → 100（默认）；0 = 报表只报 token 不估算金额
# 配额按"LLM 调用次数"计量（见 Docs/Plans/01-本地生活GEO改造与优化完善计划.md § X-01）
LLM_COST_PER_MToken=100
