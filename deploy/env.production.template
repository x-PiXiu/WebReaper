# ============================================================
# WebReaper 生产环境配置（云端根目录 .env）
# 生成：2026-09-02 基于代码全量环境变量核对（internal/config/config.go
#       + cmd/server/main.go + docker-compose.yml）
# 密钥占位符【填写】处需替换为实际值；其余已按云端现状预填
# ============================================================

# ---- 公开访问地址（nginx 域名；媒体 URL/回调/sitemap 全依赖它）----
PUBLIC_BASE_URL=https://huoke.zhichen.chat

# ---- MySQL（共享已有 zhichen-mysql :13306；compose 直接读这几项）----
# ⚠️ compose 的 DB_PASSWORD 取自 MYSQL_ROOT_PASSWORD——云端 MySQL root 密码
MYSQL_ROOT_PASSWORD=【保持云端现有值】

# ---- Redis（分布式锁/三防缓存/回调 nonce/运营指标）----
# compose 默认连 localhost:16379（zhichen-redis）——端口不对则改 REDIS_PORT
# ⚠️ 多实例部署必须配 Redis，否则定时任务各实例重复执行（事故级）
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=【保持云端现有值】
REDIS_DB=0

# ---- LLM（内容生成/AI 监测）----
LLM_API_KEY=【保持云端现有值】
LLM_PROVIDER=Agnes
LLM_BASE_URL=https://apihub.agnes-ai.cn/v1
LLM_MODEL=agnes-2.5-flash

# ---- Vidu 视频/图片/音频生成 ----
# 【填写】替换为真实 Vidu API Key（占位值会导致生成走 mock 或 403）
# 也可部署后在管理后台「集成中心」配置（DB 热切换，免重启）
VIDU_API_KEY=【填写真实 Vidu Key】

# ---- 小米 MiMo（TTS/声音克隆/长文本合成——音频业务主通道之一）----
# 【新增】原云端 .env 缺失——缺失则 MiMo TTS/克隆通道整体不启用
MIMO_API_KEY=【填写 MiMo Key——本地 configs/.env 有】

# ---- 高德地图（本地生活 GEO）----
AMAP_API_KEY=【保持云端现有值】
AMAP_API_VERSION=v5

# ---- Bing 收录 ----
BING_API_KEY=【保持云端现有值】
BING_SITE_URL=https://geo.zhichen.chat

# ---- 百度收录（可选，不填则百度提交渠道关闭）----
# BAIDU_TOKEN=【可选填写】
# BAIDU_SITE=【可选填写】

# ---- 安全密钥（已为生产随机值 ✓）----
JWT_SECRET=【保持云端现有值不变】
PUBLISH_COOKIE_SECRET=【保持云端现有值不变】
JWT_EXPIRATION=86400

# ---- 抖音（OAuth 已删除——KEY 保留无害，扫码绑定不依赖）----
DOUYIN_CLIENT_KEY=【保持云端现有值】
DOUYIN_CLIENT_SECRET=【保持云端现有值】
DOUYIN_OAUTH_CALLBACK=https://huoke.zhichen.chat/webreaper/api/v1/merchant/accounts/douyin/oauth/callback
DOUYIN_OAUTH_SCOPE=trial_whitelist,user_info
FRONTEND_BASE_URL=https://huoke.zhichen.chat

# ---- RPA 浏览器（云端无显示器 → 必须无头）----
QR_LOGIN_HEADED=false

# ---- 发布 DRY_RUN（首次部署建议留空=真实发布；
#      真机校准选择器时才临时设 true，校准完删除）----
PUBLISH_DRY_RUN=

# ---- 自动盯盘 ----
AUTO_MONITOR_ENABLED=true

# ---- 文件存储（oss=云端持久化；素材 URL 公网可达——音色注册链依赖此项）----
STORAGE_TYPE=oss
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
# 云服务器内网直传（免流量费）
OSS_INTERNAL_ENDPOINT=oss-cn-guangzhou-internal.aliyuncs.com
OSS_BUCKET=zhichenai
OSS_ACCESS_KEY=【保持云端现有值】
OSS_SECRET_KEY=【保持云端现有值】
# ⚠️ 建议确认此域名已配 HTTPS（HTTP 域名嵌 HTTPS 页面会被浏览器拦）
OSS_PUBLIC_DOMAIN=https://media.zhichen.chat

# ---- Vidu 回调（可选——双通道秒级推送；不配则纯 20s 轮询）----
# PUBLIC_BASE_URL 为公网域名时自动启用回调，无需手动配置
# VIDU_CALLBACK_URL=

# ---- 以下按需（可选，缺省走默认值）----
# INDEXNOW_KEY=
# TAVILY_API_KEY=
# YT_DLP_CMD=yt-dlp
# FFMPEG_PATH=ffmpeg
