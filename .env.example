# ---- WebReaper 环境变量（复制为 .env 填写实际值）----
# 部署时把此文件复制为 .env，填入实际密钥

# 公开访问地址（nginx 域名，生成 sitemap/公开文章 URL 用）
PUBLIC_BASE_URL=https://your-domain.com

# MySQL（共享已有 zhichen-mysql）
MYSQL_ROOT_PASSWORD=zhichen2026

# LLM（内容生成/AI 监测——必须配置，否则 LLM 相关功能不可用）
LLM_API_KEY=your-llm-api-key
LLM_PROVIDER=minimax
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.5

# Vidu 视频生成（未配置则走 mock 模式）
VIDU_API_KEY=your-vidu-api-key

# 高德地图（本地生活 GEO——门店搜索/地址联想）
AMAP_API_KEY=your-amap-api-key

# Bing 收录验证（可选）
BING_API_KEY=
BING_SITE_URL=

# 安全密钥（生产必须改！）
JWT_SECRET=generate-a-random-secret-here
PUBLISH_COOKIE_SECRET=generate-another-random-secret

# 自动盯盘（默认开启）
AUTO_MONITOR_ENABLED=true
