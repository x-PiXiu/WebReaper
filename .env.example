# ---- WebReaper 云端环境变量（复制为 .env 填写实际值）----
# 部署时把此文件复制为 .env，填入实际密钥。
# ⚠️ .env 已被 .gitignore 忽略——真实密钥绝不提交进仓库。

# ── 站点地址 ──
# 公开访问地址（nginx 域名，生成 sitemap/公开文章 URL 用）
PUBLIC_BASE_URL=https://your-domain.com
# 前端地址（抖音 OAuth 授权回调完成后 302 跳回的前端页面）
FRONTEND_BASE_URL=https://your-domain.com

# ── MySQL（共享已有 zhichen-mysql，容器经 localhost:13306 连接）──
MYSQL_ROOT_PASSWORD=your-mysql-password

# ── Redis（分布式锁/三防缓存/回调 nonce/运营指标）──
# REDIS_HOST 留空 = 未启用（自动降级单机模式：NoopLock/内存 nonce/无缓存，业务不中断）；
# 多实例部署必须配置——否则定时任务会在各实例重复执行（事故级）。
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ── 抖音开放平台 OAuth（官方授权绑定——API 通道）──
# open.douyin.com 网站应用凭证；未配置则抖音仅支持浏览器扫码绑定（RPA 通道）
DOUYIN_CLIENT_KEY=your-douyin-client-key
DOUYIN_CLIENT_SECRET=your-douyin-client-secret
# 授权回调地址：必须与开放平台控制台「设置-开发配置-授权回调地址」完全一致（一字不差）。
# 注意带上 API_PREFIX（compose 默认 /webreaper），指向后端公开回调端点：
DOUYIN_OAUTH_CALLBACK=https://your-domain.com/webreaper/api/v1/merchant/accounts/douyin/oauth/callback

# ── LLM（内容生成/AI 监测——必须配置，否则 LLM 相关功能不可用）──
LLM_API_KEY=your-llm-api-key
LLM_PROVIDER=minimax
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.5

# ── Vidu 视频生成（未配置则走 mock 模式）──
VIDU_API_KEY=your-vidu-api-key

# ── 高德地图（本地生活 GEO——门店搜索/地址联想）──
AMAP_API_KEY=your-amap-api-key

# ── Bing 收录验证（可选）──
BING_API_KEY=
BING_SITE_URL=https://your-domain.com

# ── 安全密钥（生产必须改！JWT 签发 / cookie·token 加密）──
JWT_SECRET=generate-a-random-secret-here
PUBLISH_COOKIE_SECRET=generate-another-random-secret

# ── 自动盯盘（默认开启）──
AUTO_MONITOR_ENABLED=true

# ── 文件存储（本地/云端双模式）──
# local（默认/本地开发）= 本地文件 ./data/media
# oss（云端部署）= 阿里云 OSS（素材上传 + AI 产物转存到云端）
STORAGE_TYPE=oss
# OSS 配置（STORAGE_TYPE=oss 时必填）
# ⚠️ 建议使用 RAM 子账号的 AK/SK（仅授权该 bucket 的读写），不要用主账号 AK
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_INTERNAL_ENDPOINT=oss-cn-guangzhou-internal.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY=your-access-key-id
OSS_SECRET_KEY=your-access-key-secret
OSS_PUBLIC_DOMAIN=  # 可选：绑定的 CDN 域名（空=用默认 https://bucket.endpoint）
